# Vendored upstream license texts are verified by SHA-256 against
# legal/remote-notices.json during packaging. Any end-of-line conversion would
# change their bytes and force a network re-fetch on checkout (which breaks the
# Windows release build when the upstream host is unreachable). Keep them byte
# for byte as committed on every platform.
legal/generated/** -text
runtime/zotero-mcp/licenses/** -text

# Manuals are generated binary artifacts; never diff or normalise them as text.
*.pdf -text -diff

# Hash-pinned QA evidence must retain its exact bytes on every platform.
audit/embeddinggemma-2/** -text
audit/research-chat-grounding/** -text
# The archived long-document fixture includes a tested terminal blank line.
audit/embeddinggemma-2/fixtures/fixture-19.md whitespace=-blank-at-eof
