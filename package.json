  "build": {
    "appId": "app.nodus.desktop",
    "productName": "Nodus",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "legal/NODUS_LICENSE.txt"
      },
      {
        "from": "SOURCE_CODE.md",
        "to": "legal/SOURCE_CODE.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "legal/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "PRIVACY.md",
        "to": "legal/PRIVACY.md"
      },
      {
        "from": "legal",
        "to": "legal"
      },
      {
        "from": "dist-zotero/nodus-zotero.xpi",
        "to": "zotero/nodus-zotero.xpi"
      },
      {
        "from": "dist-zotero/updates.json",
        "to": "zotero/updates.json"
      },
      {
        "from": "dist-browser/nodus-research-connector-chrome.zip",
        "to": "browser/nodus-research-connector-chrome.zip"
      },
      {
        "from": "server",
        "to": "nodus-server",
        "filter": [
          "**/*",
          "!data",
          "!data/**/*",
          "!.env"
        ]
      },
      {
        "from": "cloudflare/dist",
        "to": "nodus-cloudflare"
      },
      {
        "from": "build/capability-bootstrap",
        "to": "capability-bootstrap"
      },
      {
        "from": "build/zotero-mcp",
        "to": "zotero-mcp"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "word-addin/**/*",
      "browser-extension/**/*",
      "zotero-plugin/**/*",
      "electron/assets/**/*",
      "scripts/nodus_copilot.py"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "jorgepb96",
        "repo": "nodus",
        "releaseType": "draft",
        "channel": "latest"
      }
    ],
    "beforePack": "build/beforePack.cjs",
    "afterPack": "build/afterPack.cjs",
    "asarUnpack": [
      "zotero-plugin/**/*",
      "node_modules/@openai/codex-*/vendor/**/*",
      "node_modules/@github/copilot-*/**/*",
      "node_modules/heic-decode/**/*",
      "node_modules/libheif-js/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/sharp-*/**/*",
      "node_modules/@img/sharp-libvips-*/**/*"
    ],
    "mac": {
      "extraFiles": [
        {
          "from": "build/NodusDockTile.docktileplugin",
          "to": "PlugIns/NodusDockTile.docktileplugin"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nodus Research usa el micrófono únicamente cuando inicias un dictado o una grabación de estudio.",
        "NSCameraUsageDescription": "Nodus Research permite que un sitio abierto en su navegador integrado use la cámara únicamente después de que lo autorices para ese sitio.",
        "NSAppleEventsUsageDescription": "Nodus Research puede usar una aplicación de presentaciones instalada únicamente para convertir a PDF el archivo que elijas importar.",
        "NSDockTilePlugIn": "NodusDockTile.docktileplugin",
        "NSCalendarsUsageDescription": "Nodus sincroniza los eventos de docencia y estudio con el calendario de Apple que elijas, solo si activas esta función.",
        "NSCalendarsFullAccessUsageDescription": "Nodus necesita acceso completo para crear, actualizar y eliminar las copias de tus eventos en el calendario de Apple que elijas.",
        "NSLocalNetworkUsageDescription": "Nodus enlaza Presenter con tu iPhone o iPad únicamente mientras presentas.",
        "NSBonjourServices": [
          "_nodus-presenter._tcp",
          "_nodus-peer._tcp"
        ]
      },
      "target": [
        {
